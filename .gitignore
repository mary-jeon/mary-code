# Safety net — runtime records are created in ~/.claude/mary/, never here.
# This guards against accidentally running the harness inside the repository.
RULES.md
FAILLOG.md
_work.md
_work-*.md
approvals.jsonl

# Local-only Claude settings — per-machine permissions never go in the repository.
# (Also ignored by the user's global gitignore; this keeps the repo self-defending.)
.claude/settings.local.json

# Local-only working folders and documents — never published.
talk/
Mary-Code-Canonical.md
_submission-draft.md

# Editors
.obsidian/

# OS
.DS_Store
Thumbs.db
desktop.ini
